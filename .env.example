# ==============================================================
# 圣诺联合官网 环境变量示例配置
# 复制本文件为 .env 后按实际环境修改；相对路径均以项目根目录为基准
# 安全提示：本文件中的密码均为占位示例，务必为每个环境替换为独立的强随机口令，禁止复用示例值
# ==============================================================

# ── 后端（Spring Boot）基础 ───────────────────────────────────
# Spring Boot 应用名（服务注册 / 日志标识使用）
SPRING_APPLICATION_NAME=sinounion

# 后端 HTTP 服务端口（浏览器直连后端或反向代理转发的目标端口）
SERVER_PORT=8080

# ── 前端静态目录与运行配置 ───────────────────────────────────
# 前端 public 目录：后端生成的 SEO 文件（robots.txt / sitemap.xml / llms.txt / llms-full.txt）
# 会同步写入该目录，需确保后端进程对该目录有写权限
APP_FRONTEND_PUBLIC_DIR=../frontend/public

# 管理后台「配置文件在线编辑」读写 application.yml 的路径
# （容器/部署环境通常改为 ./config/application.yml）
APP_CONFIG_FILE_PATH=./app-config.json

# 容器前端构建时注入的后端直连地址（浏览器直连后端端口以获取真实访客 IP）
FRONTEND_API_BASE_URL=http://localhost:8080

# 浏览器直连后端时不信任任何转发头，防止客户端伪造 X-Real-IP / X-Forwarded-For 冒充来源 IP
APP_TRUST_PROXY_IP_HEADER=false

# ── IP 归属地解析 ─────────────────────────────────────────────
# 来源 IP 归属地解析方式：offline=仅离线 ip2region；ipwho=仅在线 ipwho.is；
# auto=在线优先，失败时回退离线（默认推荐）
APP_IP_LOCATION_PROVIDER=auto
# 在线归属地解析服务地址（ipwho.is）
APP_IPWHO_URL=https://ipwho.is
# 在线归属地解析请求超时时间（毫秒）
APP_IPWHO_TIMEOUT_MS=3000

# ── PostgreSQL（供 AI_consultant 服务直连使用）────────────────
# 数据库地址（容器部署时为宿主机映射 IP）
DB_HOST=localhost
# 数据库宿主机映射端口（容器内一般为 5432）
DB_PORT=15432
# 数据库名
DB_NAME=sinounion
# 数据库用户名
DB_USER=root
# 数据库密码（占位示例，务必替换为强随机口令）
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# ── PostgreSQL（后端 Spring Boot 数据源，须与上方保持一致）────
# JDBC 连接串
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:15432/sinounion
# 数据源用户名
SPRING_DATASOURCE_USERNAME=root
# 数据源密码（须与上方 DB_PASSWORD 保持一致）
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# ── Redis（供 AI_consultant 服务直连使用）─────────────────────
# Redis 地址（容器部署时为宿主机映射 IP）
REDIS_HOST=localhost
# Redis 宿主机映射端口（容器内一般为 6379）
REDIS_PORT=16379
# Redis 密码（未设置密码时留空；设置密码请用强随机口令）
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
# Redis 逻辑库编号（0-15）
REDIS_DB=0

# ── Redis（后端 Spring Boot，须与上方保持一致）────────────────
SPRING_REDIS_HOST=localhost
SPRING_REDIS_PORT=16379
SPRING_REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
SPRING_REDIS_DATABASE=0

# ── 前端 ──────────────────────────────────────────────────────
# 前端本地开发（next dev）与生产静态托管（serve）使用的端口
FRONTEND_PORT=80

# ── AI 顾问服务 ───────────────────────────────────────────────
# AI 服务会话记忆（对话历史存档）文件目录
AI_SERVICE_MEMORIES_DIR=../AI_consultant/memories
# AI 服务 HTTP 地址（后端调用：知识库同步 / SEO 生成 / 违规问题检测等）
AI_SERVICE_URL=http://localhost:8000
# AI 顾问人设与回答约束的系统提示词（可在管理后台覆盖）
AI_SYSTEM_PROMPT=你是圣诺联合科技有限公司的 AI 顾问。

# ── 文件上传 ──────────────────────────────────────────────────
# 后端上传文件（图片 / 附件 / 临时文件）的保存目录
UPLOAD_PATH=../uploads

# AI 服务媒体文件根目录（相对项目根目录），用于图片 / 附件文档向量化
AI_UPLOAD_PATH=uploads

# AI 服务在本地读不到上传文件时，通过该后端地址 HTTP 兜底拉取
BACKEND_BASE_URL=http://localhost:8080

# 允许上传的 MIME 类型（逗号分隔，如需不限填 *）
UPLOAD_ALLOWED_TYPES=image/png,image/webp,image/gif,application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain,text/markdown

# ── JWT 认证 ──────────────────────────────────────────────────
# JWT 签名密钥：生产环境务必替换为足够长的强随机字符串
JWT_SECRET=REPLACE_WITH_STRONG_SECRET

# JWT 有效期（毫秒）：86400000 = 24 小时
JWT_EXPIRATION=86400000

# ── 敏感配置加密（短信 Secret / 模型 API Key 等）──────────────────
# 后端与 AI 服务（Python）共用的 AES 落盘密钥：Base64 编码的 32 字节随机值
# 生成方式（任选其一）：
#   Linux:   openssl rand -base64 32
#   Windows: [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
# 未配置时后端会在首次启动自动生成并追加到 .env，生产环境请务必显式设置并妥善保管
CONFIG_CRYPTO_AES_KEY=
