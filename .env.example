# ==============================================================
# 复制本文件为 .env 后按环境修改；相对路径以项目根目录为基准。
# 覆盖优先级：OS 环境变量 > .env 文件 > 代码默认值；.env 由 docker-compose 挂载进容器(/app/.env)。
# 安全：本文件中的密码/密钥均为占位示例，务必为每个环境替换为独立的强随机值，禁止复用。
# ==============================================================

# ── 后端（Spring Boot）──
# 作用：Spring Boot 应用名（服务注册 / 日志标识）
# 填写：固定为项目名，一般无需修改
SPRING_APPLICATION_NAME=sinounion

# 作用：后端监听地址（server.address）
# 填写：本地开发填 localhost/127.0.0.1；docker/服务器部署填 0.0.0.0（所有网卡，容器内亦可访问）
BACKEND_HOST=0.0.0.0

# 作用：后端监听端口（server.port），同时为 docker 宿主机映射端口 / nginx 代理目标端口
# 填写：与 docker-compose.yml 中 backend 服务映射端口及 nginx 代理配置保持一致
BACKEND_PORT=8080

# ── Python AI 服务（FastAPI）──
# 作用：uvicorn 监听地址（由 AI_consultant/run.py（或 api.py / main.py 入口）读取）
# 填写：本地开发填 localhost/127.0.0.1；docker 容器内需填 0.0.0.0
PYTHON_HOST=localhost

# 作用：uvicorn 监听端口，同时为 docker 映射端口 / nginx 代理目标端口
# 填写：与 docker-compose.yml 中 python 服务映射端口及 nginx 代理配置保持一致
PYTHON_PORT=8000

# ── 前端（Next.js）──
# 作用：前端开发服务器监听地址（next dev -H）
# 填写：本地开发 localhost/127.0.0.1；docker/服务器 0.0.0.0
FRONTEND_HOST=0.0.0.0

# 作用：前端端口（本地开发 next dev 读取；生产由 nginx 容器托管）
# 填写：本地开发填本机空闲端口；生产由 docker-compose.yml 中 frontend 服务映射（默认 80）
FRONTEND_PORT=3200

# ── PostgreSQL（后端与 AI 服务共用）──
# 作用：PostgreSQL 数据库地址
# 填写：本机填 localhost/127.0.0.1；容器部署填宿主机映射 IP 或 docker 服务名 sino-website-postgresql
PG_HOST=localhost

# 作用：PostgreSQL 端口
# 填写：与 docker-compose.yml 中 postgres 服务映射的宿主机端口一致（容器内为 5432）
PG_PORT=15432

# 作用：数据库用户名
# 填写：与 docker-compose.yml 中 POSTGRES_USER 一致
PG_USER=root

# 作用：数据库密码
# 填写：与 docker-compose.yml 中 POSTGRES_PASSWORD 一致（容器首次初始化时创建，跨环境须更换）
# 生成(Linux)：openssl rand -base64 24
# 生成(Windows)：[Convert]::ToBase64String((1..24 | %{ Get-Random -Maximum 256 }))
PG_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD

# 作用：数据库名
# 填写：与 docker-compose.yml 中 POSTGRES_DB 一致
PG_DATABASE=sinounion
# 注：Spring 数据源 URL(PG_SERVICE_URL)由 PG_* 自动推导；特殊场景可用 SPRING_DATASOURCE_URL/_USERNAME/_PASSWORD 覆盖

# ── Redis（后端与 AI 服务共用）──
# 作用：Redis 地址
# 填写：本机填 localhost/127.0.0.1；容器部署填宿主机映射 IP 或 docker 服务名 sino-website-redis
REDIS_HOST=localhost

# 作用：Redis 端口
# 填写：与 docker-compose.yml 中 redis 服务映射的宿主机端口一致（容器内为 6379）
REDIS_PORT=16379

# 作用：Redis 用户名（ACL）
# 填写：未设置 ACL 用户名时留空
REDIS_USER=

# 作用：Redis 密码
# 填写：与 docker-compose.yml 中 redis 启动命令 --requirepass 的口令一致；未设密码时留空
# 生成(Linux)：openssl rand -base64 24
# 生成(Windows)：[Convert]::ToBase64String((1..24 | %{ Get-Random -Maximum 256 }))
REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD

# 作用：Redis 逻辑库编号
# 填写：0-15，按需选择
REDIS_DATABASE=0
# 注：连接由 REDIS_* 自动推导；特殊场景可用 SPRING_REDIS_HOST/_PORT/_PASSWORD/_DATABASE 覆盖

# ── 目录 ──
# 作用：AI 对话记忆（历史存档）目录
# 填写：相对项目根目录；保持默认即可
AI_SERVICE_MEMORIES_DIR=../AI_consultant/memories

# 作用：前端 public 目录，后端生成的 SEO 文件(robots.txt/sitemap.xml/llms.txt)同步写入处
# 填写：与前端项目目录结构一致；需确保后端进程对该目录有写权限
APP_FRONTEND_PUBLIC_DIR=../frontend/public

# 作用：上传文件（图片/附件/临时文件）保存目录；AI 对话附件存于其 temp 子目录(UPLOAD_PATH/temp)
# 填写：相对项目根目录；保持默认即可
UPLOAD_PATH=uploads
# 注：允许上传 MIME、JWT 有效期、IP 归属地、代理转发头信任策略均为代码内固定值，无需配置

# ── JWT 认证 与 敏感配置加密 ──
# 作用：JWT 签名密钥（后端签发/校验；AI 服务 auth.py 用同一密钥校验管理端 JWT）
# 填写：强随机字符串，生产务必替换
# 生成(Linux)：openssl rand -base64 64
# 生成(Windows)：[Convert]::ToBase64String((1..64 | %{ Get-Random -Maximum 256 }))
# 查看：项目根目录 .env；或管理后台「环境变量」页（脱敏显示、可在线编辑）
JWT_SECRET=REPLACE_WITH_STRONG_SECRET

# 作用：后端→AI 服务内部调用令牌；未配置时服务间调用退化为服务端 JWT（依赖 JWT_SECRET）
# 填写：强随机字符串；后端与 AI 服务两侧必须一致
# 生成(Linux)：openssl rand -base64 48
# 生成(Windows)：[Convert]::ToBase64String((1..48 | %{ Get-Random -Maximum 256 }))
# 查看：项目根目录 .env（不在管理后台受管键列表）
AI_INTERNAL_TOKEN=REPLACE_WITH_STRONG_SECRET

# 作用：敏感配置落盘 AES 密钥（Base64 32 字节），用于加密 system_configs 表中短信 Secret / 模型 API Key 等
# 填写：Base64 编码的 32 字节随机值；兼容 Base64(16/24/32 字节)或任意字符串（SHA-256 派生）
# 生成(Linux)：openssl rand -base64 32
# 生成(Windows)：[Convert]::ToBase64String((1..32 | %{ Get-Random -Maximum 256 }))
# 查看：项目根目录 .env（后端未配置时首次启动自动生成并追加该行；生产务必显式设置并妥善保管）
CONFIG_CRYPTO_AES_KEY=