# ============================================================
# 部署环境变量示例
# 复制为 docker/.env 后按需修改：cp .env.example .env
# docker compose 会自动从 docker/.env 读取（变量替换用）
# ============================================================

# ---- 镜像来源（生产使用 GitHub Actions 推送到 GHCR 的镜像）----
REGISTRY=ghcr.io/sinocli/sino_website
TAG=latest

# ---- 对外访问端口（Nginx 宿主映射端口）----
HTTP_PORT=80

# ---- 数据库 ----
DB_NAME=sinounion
DB_USER=sinounion
DB_PASSWORD=sinounion

# ---- Redis ----
REDIS_PASSWORD=sinoredis

# ---- 后端 ----
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRATION_HOURS=24
# 前端实际访问的 API 公网地址（用于生成链接/邮件等），如 https://your.domain
FRONTEND_API_BASE_URL=http://localhost:8080
LOG_LEVEL=info

# ---- AI 服务：LLM / 向量模型配置 ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_VL_MODEL=qwen-vl-plus

EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

VL_API_KEY=
VL_BASE_URL=
VL_MODEL=

RERANKER_API_KEY=
RERANKER_BASE_URL=
RERANKER_MODEL=

RAG_ENABLED=false
MEMORY_ENABLED=true
