# ============================================================
# 部署环境变量示例
# 复制为 docker/.env 后按需修改：cp .env.example .env
# docker compose 会自动从 docker/.env 读取（变量替换用）
# ============================================================

# ---- 镜像来源（生产使用 GitHub Actions 推送到 GHCR 的镜像）----
REGISTRY=ghcr.io/ai-native-website-os/website-os
TAG=latest

# ---- 本地源码构建时使用国内镜像源（仅 docker compose up --build 生效）----
# 控制 npm/pip/maven 是否切换国内源：true=国内加速，false=官方源（默认）
# 生产部署用 `docker compose pull && up` 不构建，此变量无影响
# 注意：国外 CI 环境构建时不要设为 true（国内源在国外反而慢）
CN_MIRROR=false

# ---- 对外访问端口（Nginx 宿主映射端口）----
HTTP_PORT=80

# ---- 数据库 ----
DB_NAME=sinounion
DB_USER=sinounion
DB_PASSWORD=sinounion

# ---- Redis ----
REDIS_PASSWORD=sinoredis

# ---- 后端 ----
JWT_SECRET=please-change-this-to-a-long-random-string
JWT_EXPIRATION_HOURS=24
# AI 服务内部调用令牌（后端 → AI 服务），务必设为强随机字符串
AI_INTERNAL_TOKEN=
# 敏感配置 AES 落盘密钥（Base64 编码的 16/24/32 字节，或任意字符串自动派生）。
# 必须同时提供给 backend 与 ai 两个服务且保持一致，否则 ai 服务无法解密后端写入的
# enc:v1: 密文（模型 API Key 等会读为空）。生成方式：openssl rand -base64 32
CONFIG_CRYPTO_AES_KEY=
# 前端实际访问的 API 公网地址（用于生成链接/邮件等），如 https://your.domain
FRONTEND_API_BASE_URL=http://localhost:8080
LOG_LEVEL=info

# ---- AI 服务：监听地址与前端访问地址 ----
# AI 服务 uvicorn 监听地址/端口（容器内需 0.0.0.0 才能被 backend/nginx 访问）
AI_HOST=0.0.0.0
AI_PORT=8000
# 前端浏览器访问 AI 服务的地址（可选，构建期内联，如 https://your.domain/ai）
NEXT_PUBLIC_AI_API_BASE_URL=

# ---- AI 服务：LLM / 向量模型配置 ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
QWEN_VL_MODEL=qwen-vl-plus

EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

VL_API_KEY=
VL_BASE_URL=
VL_MODEL=

RERANKER_API_KEY=
RERANKER_BASE_URL=
RERANKER_MODEL=

RAG_ENABLED=false
MEMORY_ENABLED=true
