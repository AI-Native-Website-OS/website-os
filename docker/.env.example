# ============================================================
# 部署环境变量示例
# 复制为 docker/.env 后按需修改：cp .env.example .env
# docker compose 会自动从 docker/.env 读取（变量替换用）
# ============================================================

# ---- 镜像来源（生产使用 GitHub Actions 推送到 GHCR 的镜像）----
REGISTRY=ghcr.io/ai-native-website-os/website-os
#REGISTRY=ghcr.nju.edu.cn/ai-native-website-os/website-os
#REGISTRY=ghcr.m.daocloud.io/ai-native-website-os/website-os
#REGISTRY=ghcr.1ms.run/ai-native-website-os/website-os
TAG=latest

# ---- 本地源码构建时使用国内镜像源（仅 docker compose up --build 生效）----
# 控制 npm/pip/maven 是否切换国内源：true=国内加速，false=官方源（默认）
# 生产部署用 `docker compose pull && up` 不构建，此变量无影响
# 注意：国外 CI 环境构建时不要设为 true（国内源在国外反而慢）
CN_MIRROR=false

# ---- 对外访问端口（Nginx 宿主映射端口）----
HTTP_PORT=80

# ---- 数据库 ----
DB_NAME=sinounion
DB_USER=sinounion
DB_PASSWORD=sinounion

# ---- Redis ----
REDIS_PASSWORD=sinoredis

# ---- 后端 ----
JWT_SECRET=please-change-this-to-a-long-random-string
# AI 服务内部调用令牌（后端 → AI 服务），务必设为强随机字符串
AI_INTERNAL_TOKEN=your-random-secret-token-here
# 敏感配置 AES 落盘密钥（Base64 编码的 16/24/32 字节，或任意字符串自动派生）。
# 必须同时提供给 backend 与 ai 两个服务且保持一致，否则 ai 服务无法解密后端写入的
# enc:v1: 密文（模型 API Key 等会读为空）。生成方式：openssl rand -base64 32
CONFIG_CRYPTO_AES_KEY=bKqp1ctgRsHJEavYkNadT0J0BycfNYQgl47flF98HLE=
LOG_LEVEL=info

# ---- AI 服务：uvicorn 监听地址/端口（容器内需 0.0.0.0 才能被 backend/nginx 访问）----
# 对应 AI_consultant/run.py（api.py）读取的 PYTHON_HOST/PYTHON_PORT
PYTHON_HOST=0.0.0.0
PYTHON_PORT=8000

# ---- AI 服务：LLM / 向量模型配置（启动兜底默认值，AI_consultant/main.py 读取）----
# 生产环境建议在管理后台「模型参数配置」中维护并写库（LLM_*/EMBEDDING_*/VL_*/RERANK_*）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

VL_BASE_URL=
VL_API_KEY=
VL_MODEL=

RERANK_BASE_URL=
RERANK_API_KEY=
RERANK_MODEL=
